# Copy to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=config.django.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# docker compose exposes pgvector Postgres on 5433
DATABASE_URL=postgres://documento:documento@localhost:5433/documento

# --- RAG: provider-agnostic via LangChain -------------------------------
# LLM used for answer generation: "<provider>:<model>" (langchain init_chat_model)
#   anthropic:claude-opus-5 | openai:gpt-4.1 | ollama:llama3.1
LLM_MODEL=anthropic:claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
#
# OpenRouter (or any OpenAI-compatible gateway): use the "openai:" provider with
# the gateway's model slug, and point it at the gateway. Needs `uv sync --extra openai`.
# LLM_MODEL=openai:anthropic/claude-sonnet-4.5
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...

# Embeddings used for indexing + retrieval. Default is local (fastembed, ONNX, no API key).
#   fastembed | openai | ollama | huggingface
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model's output size. Changing the model => run `manage.py reindex`.
EMBEDDING_DIM=384

CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
