      "settingSendCookies": true,
      "settingStoreCookies": true,
      "afterResponseScript": "// Runs after the response arrives; stores the JWTs for every other request.\nif (insomnia.response.code === 200) {\n  const body = insomnia.response.json();\n  insomnia.environment.set(\"access_token\", body.access);\n  insomnia.environment.set(\"refresh_token\", body.refresh);\n  console.log(\"access_token stored\");\n} else {\n  console.log(\"token request failed\", insomnia.response.code, insomnia.response.text());\n}\n"
    },
